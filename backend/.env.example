# Copy to .env and fill in. Never commit .env (it is gitignored).

# Postgres connection string.
#   local:      postgresql://user:password@localhost/dev_diary
#   production: copy from Render → dev-diary-api → Environment
DATABASE_URL=postgresql://user:password@localhost/dev_diary

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
