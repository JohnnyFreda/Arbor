# Copy to .env and fill in. Never commit .env (it is gitignored).

# Postgres connection string.
#   local:      postgresql://user:password@localhost/arbor
#   production: copy from Render → arbor-api → Environment
DATABASE_URL=postgresql://user:password@localhost/arbor

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Interpretation. Leave ANTHROPIC_API_KEY empty and captures still save --
# they land in `skipped` and show in the inbox unstructured. Key from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
INTERPRETER_MODEL=claude-opus-5
# Shared with adaptive thinking, so it needs more headroom than the JSON alone.
INTERPRETER_MAX_TOKENS=4096

# Local interpretation via Ollama. Setting OLLAMA_MODEL turns it on; captures
# are then interpreted on this machine and never leave it.
#   ollama pull qwen2.5:3b
INTERPRETER_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
